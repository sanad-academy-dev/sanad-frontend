# Local IDE / dev-only files
.mcp.json
# `.vscode/*` not `.vscode/`: git cannot re-include a file whose parent DIRECTORY is
# excluded, so the negation below only works against the contents form. The settings
# file is already tracked, and without this any commit touching it fails — the
# pre-commit hook re-stages every staged *.json and `git add` refuses an ignored path.
.vscode/*
!.vscode/settings.json
docker-compose.yml

# Auto-generated by TanStack Router
src/routeTree.gen.ts
# Raw regulatory-registry snapshots — re-fetchable via scripts/catalog/fetch-*.mjs.
# The normalized pack (scripts/catalog/data/*-pack.json) IS committed: it is the
# reviewable source of record and the input to the migration generator.
scripts/catalog/data/*-raw.jsonl
scripts/catalog/data/apvma/

# incremental tsc cache — CI-only artifact (fast job), never committed
.tsbuildinfo
tsbuild/

# Expo dev-server artifacts
.expo/
