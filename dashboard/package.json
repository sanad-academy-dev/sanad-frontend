{
  "name": "sanad-dashboard",
  "description": "Admin dashboard frontend for the Sanad API",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "vite dev --port 3001 --host 0.0.0.0",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview --port 3001",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "gen:routetree": "node scripts/generate-route-tree.mjs",
    "knip": "knip",
    "format": "biome check --write --unsafe",
    "typecheck": "bun scripts/run-exclusive.mjs typecheck bun run typecheck:raw",
    "typecheck:raw": "node scripts/typecheck.mjs",
    "env:list": "bun scripts/vercel-env.ts list",
    "env:add": "bun scripts/vercel-env.ts add",
    "env:remove": "bun scripts/vercel-env.ts remove",
    "env:sync": "bun scripts/vercel-env.ts sync",
    "env:sync:prod": "bun scripts/vercel-env.ts sync --env production",
    "env:sync:dry": "bun scripts/vercel-env.ts sync --dry-run",
    "prepare": "husky",
    "dev:lan": "vite dev --port 3001 --host 0.0.0.0",
    "typecheck:cold": "rm -rf tsbuild && bun run typecheck",
    "typecheck:legacy": "bun scripts/run-exclusive.mjs typecheck-legacy bun run typecheck:raw"
  },
  "dependencies": {
    "@better-auth/i18n": "^1.6.5",
    "@cornerstonejs/core": "^5.6.12",
    "@cornerstonejs/dicom-image-loader": "^5.6.12",
    "@cornerstonejs/metadata": "^5.10.7",
    "@cornerstonejs/tools": "^5.6.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@sentry/react": "^10.48.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-hotkeys": "0.9.1",
    "@tanstack/react-hotkeys-devtools": "0.6.6",
    "@tanstack/react-query": "5.99.2",
    "@tanstack/react-query-devtools": "5.99.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.166.9",
    "@tanstack/react-router-ssr-query": "1.166.9",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "@tanstack/router-plugin": "1.168.23",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dicom-parser": "^1.8.21",
    "i18next": "^26.0.6",
    "i18next-http-backend": "^3.0.5",
    "input-otp": "^1.4.2",
    "lefthook": "^2.1.6",
    "livekit-client": "^2.20.2",
    "lucide-react": "^1.11.0",
    "maplibre-gl": "^6.4.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-country-state-city": "^1.1.12",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.16",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tunnel-rat": "^0.1.2",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-plugin-query": "^5.99.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^6.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
